# GoldSense Backend Environment Variables
# Copy this file to .env and fill in your actual values.

# Required
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
GROQ_API_KEY=your-groq-api-key

# Optional market-data providers
ALPHAVANTAGE_KEY=
NEWSAPI_KEY=
PUBLIC_APP_URL=https://gold-sense-five.vercel.app

# Optional Firebase push notifications
# Local development: prefer FIREBASE_SERVICE_ACCOUNT_PATH
# Hosted environments: prefer FIREBASE_SERVICE_ACCOUNT_JSON
# Do not paste raw multiline JSON into .env
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://gold-sense-five.vercel.app

# Optional pricing overrides
GOLDSENSE_CUSTOMS_DUTY=0.06
GOLDSENSE_GST=0.03
GOLDSENSE_MUMBAI_PREMIUM_PCT=0.0
